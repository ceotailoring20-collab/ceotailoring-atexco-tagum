<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CEO Tailoring | Atexco Tagum — Sublimation Printing, Heat Press & Tailoring</title>
  <meta name="description" content="Professional sublimation printing, heat press, and tailoring services in Tagum City and Panabo City, Davao del Norte. Trusted partner for teams, shops, and garment businesses.">
  <meta name="keywords" content="sublimation printing Tagum, heat press Panabo, jersey printing Davao, tailoring Tagum City, B2B printing Davao del Norte">

  <!-- Inter Font (Clean, Corporate, Highly Legible) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ==========================================================================
       DESIGN SYSTEM & VARIABLES
       ========================================================================== */
    :root {
      --primary: #0B1F3A;         /* Deep Navy Blue */
      --secondary: #174F91;       /* Royal Blue */
      --accent: #BFC5CC;          /* Silver Accent */
      --accent-light: #E4E7EB;    /* Light Silver Border */
      --bg-white: #FFFFFF;
      --bg-light: #F3F5F7;        /* Light Gray */
      --text-dark: #252A30;       /* Dark Charcoal */
      --text-muted: #5A626E;      /* Secondary Gray */
      --border-color: #DDE2E7;
      --max-width: 1200px;
      --transition: all 0.25s ease-in-out;
      --shadow-sm: 0 1px 3px rgba(11, 31, 58, 0.08);
      --shadow-md: 0 4px 16px rgba(11, 31, 58, 0.08);
      --shadow-lg: 0 10px 30px rgba(11, 31, 58, 0.12);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: var(--text-dark);
      background-color: var(--bg-white);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: var(--transition);
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      outline: none;
    }

    .container {
      width: 100%;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==========================================================================
       TYPOGRAPHY & UTILITY
       ========================================================================== */
    .section-eyebrow {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--secondary);
      margin-bottom: 8px;
    }

    .section-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.25;
      margin-bottom: 16px;
    }

    .section-desc {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 720px;
      margin: 0 auto 48px auto;
    }

    .text-center {
      text-align: center;
    }

    .divider {
      width: 60px;
      height: 3px;
      background-color: var(--secondary);
      margin: 0 auto 24px auto;
    }

    .divider-left {
      margin-left: 0;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-weight: 600;
      font-size: 0.95rem;
      padding: 13px 26px;
      border-radius: 4px;
      transition: var(--transition);
      letter-spacing: 0.3px;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #fff;
      border: 1px solid var(--primary);
    }

    .btn-primary:hover {
      background-color: var(--secondary);
      border-color: var(--secondary);
      color: #fff;
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--primary);
      border: 1.5px solid var(--primary);
    }

    .btn-secondary:hover {
      background-color: var(--primary);
      color: #fff;
    }

    .btn-outline-white {
      background-color: transparent;
      color: #fff;
      border: 1.5px solid #fff;
    }

    .btn-outline-white:hover {
      background-color: #fff;
      color: var(--primary);
    }

    .btn-royal {
      background-color: var(--secondary);
      color: #fff;
    }

    .btn-royal:hover {
      background-color: #103c72;
      color: #fff;
    }

    /* ==========================================================================
       TOP BAR & HEADER
       ========================================================================== */
    .top-bar {
      background-color: var(--primary);
      color: var(--accent);
      font-size: 0.82rem;
      padding: 8px 0;
      border-bottom: 1px solid rgba(191, 197, 204, 0.15);
    }

    .top-bar-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .top-bar-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .top-bar-item a {
      color: var(--accent);
    }

    .top-bar-item a:hover {
      color: #fff;
    }

    .site-header {
      background-color: #fff;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 80px;
    }

    .brand-logo {
      display: flex;
      flex-direction: column;
      text-decoration: none;
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: var(--primary);
      line-height: 1.1;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--secondary);
      margin-top: 2px;
    }

    .main-nav ul {
      display: flex;
      list-style: none;
      align-items: center;
      gap: 28px;
    }

    .main-nav a {
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--text-dark);
      position: relative;
    }

    .main-nav a:hover {
      color: var(--secondary);
    }

    .nav-cta {
      margin-left: 12px;
    }

    /* Mobile Menu Toggle */
    .mobile-menu-btn {
      display: none;
      background: transparent;
      padding: 8px;
      cursor: pointer;
    }

    .hamburger-icon {
      width: 24px;
      height: 2px;
      background: var(--primary);
      position: relative;
      display: inline-block;
      transition: var(--transition);
    }

    .hamburger-icon::before,
    .hamburger-icon::after {
      content: '';
      width: 24px;
      height: 2px;
      background: var(--primary);
      position: absolute;
      left: 0;
      transition: var(--transition);
    }

    .hamburger-icon::before { top: -7px; }
    .hamburger-icon::after { bottom: -7px; }

    .menu-open .hamburger-icon {
      background: transparent;
    }

    .menu-open .hamburger-icon::before {
      transform: rotate(45deg);
      top: 0;
    }

    .menu-open .hamburger-icon::after {
      transform: rotate(-45deg);
      bottom: 0;
    }

    /* ==========================================================================
       HERO SECTION
       ========================================================================== */
    .hero-section {
      background: linear-gradient(rgba(11, 31, 58, 0.88), rgba(11, 31, 58, 0.92)),
                  url('https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
      color: #fff;
      padding: 100px 0 110px 0;
      border-bottom: 4px solid var(--secondary);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 50px;
    }

    .hero-badge {
      display: inline-block;
      padding: 6px 14px;
      background-color: rgba(23, 79, 145, 0.35);
      border: 1px solid var(--accent);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 3px;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.5px;
      margin-bottom: 20px;
      color: #fff;
    }

    .hero-desc {
      font-size: 1.12rem;
      line-height: 1.7;
      color: var(--accent);
      margin-bottom: 36px;
      max-width: 600px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .hero-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(191, 197, 204, 0.25);
      padding: 32px;
      border-radius: 6px;
    }

    .hero-card h3 {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(191, 197, 204, 0.2);
      padding-bottom: 10px;
    }

    .quick-specs-list {
      list-style: none;
    }

    .quick-specs-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.92rem;
      color: #E4E7EB;
      margin-bottom: 12px;
    }

    .quick-specs-list svg {
      flex-shrink: 0;
      color: var(--accent);
    }

    /* ==========================================================================
       ABOUT SECTION
       ========================================================================== */
    .about-section {
      padding: 90px 0;
      background-color: var(--bg-white);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-content p {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-bottom: 18px;
    }

    .about-features {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .feature-point {
      border-left: 3px solid var(--secondary);
      padding-left: 14px;
    }

    .feature-point h4 {
      font-size: 0.95rem;
      color: var(--primary);
      font-weight: 700;
      margin-bottom: 4px;
    }

    .feature-point p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0;
    }

    .about-image-wrapper {
      position: relative;
    }

    .about-image {
      border-radius: 6px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border-color);
      width: 100%;
      height: 420px;
      object-fit: cover;
    }

    .experience-badge {
      position: absolute;
      bottom: -20px;
      right: 20px;
      background-color: var(--primary);
      color: #fff;
      padding: 18px 24px;
      border-radius: 4px;
      border: 2px solid var(--secondary);
      box-shadow: var(--shadow-md);
    }

    .experience-badge strong {
      display: block;
      font-size: 1.4rem;
      font-weight: 800;
      color: #fff;
    }

    .experience-badge span {
      font-size: 0.8rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ==========================================================================
       SERVICES SECTION
       ========================================================================== */
    .services-section {
      padding: 90px 0;
      background-color: var(--bg-light);
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 30px;
    }

    .service-card {
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }

    .service-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
      border-color: var(--secondary);
    }

    .service-img-wrapper {
      position: relative;
      height: 210px;
      overflow: hidden;
      background-color: var(--primary);
    }

    .service-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .service-card:hover .service-img {
      transform: scale(1.03);
    }

    .service-num {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--primary);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 3px;
      border: 1px solid var(--accent);
    }

    .service-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .service-title {
      font-size: 1.18rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 12px;
    }

    .service-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    /* ==========================================================================
       PRICE LIST SECTION
       ========================================================================== */
    .pricing-section {
      padding: 90px 0;
      background-color: var(--bg-white);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      margin-bottom: 40px;
    }

    .pricing-card {
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      position: relative;
      transition: var(--transition);
    }

    .pricing-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--secondary);
    }

    .pricing-card.featured {
      border: 2px solid var(--secondary);
      background-color: #FAFCFE;
    }

    .pricing-badge {
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--secondary);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 4px 14px;
      border-radius: 12px;
    }

    .pricing-header {
      text-align: center;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--accent-light);
      padding-bottom: 20px;
    }

    .pricing-category {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    .pricing-price {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1;
    }

    .pricing-unit {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 500;
      margin-top: 6px;
    }

    .pricing-features {
      list-style: none;
      margin-bottom: 30px;
      flex-grow: 1;
    }

    .pricing-features li {
      font-size: 0.92rem;
      color: var(--text-dark);
      padding: 10px 0;
      border-bottom: 1px dashed var(--accent-light);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .pricing-features svg {
      flex-shrink: 0;
      color: var(--secondary);
      margin-top: 2px;
    }

    .pricing-notice {
      background-color: var(--bg-light);
      border-left: 4px solid var(--secondary);
      padding: 18px 24px;
      border-radius: 0 4px 4px 0;
      font-size: 0.92rem;
      color: var(--text-muted);
      max-width: 860px;
      margin: 0 auto 36px auto;
    }

    .pricing-notice strong {
      color: var(--primary);
    }

    /* ==========================================================================
       B2B PARTNERSHIP SECTION
       ========================================================================== */
    .partnership-section {
      background-color: var(--primary);
      color: #fff;
      padding: 85px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .partnership-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 50px;
      align-items: center;
    }

    .partnership-content h2 {
      color: #fff;
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 16px;
    }

    .partnership-content p {
      font-size: 1.05rem;
      color: var(--accent);
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .partnership-benefits-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(191, 197, 204, 0.2);
      border-radius: 6px;
      padding: 32px;
    }

    .benefits-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 18px;
      border-bottom: 1px solid rgba(191, 197, 204, 0.2);
      padding-bottom: 10px;
    }

    .benefits-list {
      list-style: none;
      margin-bottom: 24px;
    }

    .benefits-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.94rem;
      color: #F3F5F7;
      margin-bottom: 12px;
    }

    .benefits-list svg {
      color: var(--accent);
      flex-shrink: 0;
    }

    /* ==========================================================================
       PORTFOLIO / GALLERY SECTION
       ========================================================================== */
    .gallery-section {
      padding: 90px 0;
      background-color: var(--bg-light);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .gallery-item {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      background-color: var(--primary);
      height: 260px;
      cursor: pointer;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .gallery-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(11, 31, 58, 0.9) 0%, rgba(11, 31, 58, 0.2) 100%);
      opacity: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 20px;
      transition: var(--transition);
    }

    .gallery-item:hover img {
      transform: scale(1.04);
    }

    .gallery-item:hover .gallery-overlay {
      opacity: 1;
    }

    .gallery-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent);
      margin-bottom: 4px;
    }

    .gallery-caption {
      font-size: 0.98rem;
      font-weight: 700;
      color: #fff;
    }

    /* Lightbox Modal */
    .lightbox-modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(11, 31, 58, 0.95);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .lightbox-modal.active {
      display: flex;
    }

    .lightbox-content {
      max-width: 900px;
      width: 100%;
      background: #fff;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
      box-shadow: var(--shadow-lg);
    }

    .lightbox-img {
      width: 100%;
      max-height: 60vh;
      object-fit: contain;
      background: #000;
    }

    .lightbox-details {
      padding: 20px 24px;
      background: #fff;
    }

    .lightbox-details h4 {
      font-size: 1.1rem;
      color: var(--primary);
    }

    .lightbox-details p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .lightbox-close {
      position: absolute;
      top: 12px;
      right: 14px;
      background: #fff;
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: var(--primary);
      cursor: pointer;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    /* ==========================================================================
       CONTACT & LOCATIONS SECTION
       ========================================================================== */
    .contact-section {
      padding: 90px 0;
      background-color: var(--bg-white);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .contact-info-col h3 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 20px;
    }

    .contact-detail-card {
      margin-bottom: 28px;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 16px;
    }

    .contact-icon {
      flex-shrink: 0;
      width: 38px;
      height: 38px;
      background-color: var(--bg-light);
      border: 1px solid var(--accent-light);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--secondary);
    }

    .contact-text strong {
      display: block;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .contact-text a,
    .contact-text span {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
    }

    .contact-text a:hover {
      color: var(--secondary);
      text-decoration: underline;
    }

    .location-box {
      background-color: var(--bg-light);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 20px;
      margin-bottom: 14px;
    }

    .location-box h5 {
      font-size: 0.95rem;
      color: var(--primary);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .location-box p {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    .map-placeholder-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
